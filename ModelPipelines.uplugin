{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.1.0",
	"FriendlyName": "Model Pipelines",
	"Description": "Run Hugging Face ONNX models as task pipelines (text embeddings, text classification, image classification, object detection) on Unreal's Neural Network Engine.",
	"Category": "AI",
	"CreatedBy": "NextGen-GameDev",
	"CreatedByURL": "https://github.com/NextGen-GameDev/ModelPipelines-UE",
